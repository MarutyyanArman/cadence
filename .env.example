# Copy to .env.local for development, or paste into your host's environment
# settings for a deployment. .env.local is gitignored; never commit a real one.

# ---------------------------------------------------------------- required

# Postgres. Locally this is the Docker container; in production it is your
# hosted database. Managed Postgres usually requires TLS:
#   postgres://user:pass@host/db?sslmode=require
DATABASE_URL=postgres://postgres:arc@localhost:5433/arc

# Signs the session cookie. Any 32 random bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everybody out; it is not recoverable, so keep it somewhere.
ARC_SESSION_SECRET=

# ---------------------------------------------------------------- Telegram

# From @BotFather: /newbot, then /newapp to attach the Mini App to your
# deployed URL. Without this, Telegram sign-in returns 503 and only the
# development fallback below works.
TELEGRAM_BOT_TOKEN=

# The bot's @name, without the @. Only used to render the "Open in Telegram"
# link on the sign-in screen. Public by nature — hence NEXT_PUBLIC_.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Your own Telegram numeric id (ask @userinfobot). The first sign-in with this
# id adopts the owner account — the one that holds everything created before
# Arc had accounts. Leave blank on a fresh install. It only ever fires while
# the owner account is unclaimed, so it cannot transfer an account twice.
ARC_OWNER_TELEGRAM_ID=

# ------------------------------------------------------------- development

# Ignored when NODE_ENV=production. With it set, unauthenticated requests act
# as this account, so `npm run dev` on localhost works without going through
# Telegram. The owner account's id is the fixed one below.
ARC_DEV_USER_ID=00000000-0000-0000-0000-000000000001
